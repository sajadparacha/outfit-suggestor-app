# Production test gate credentials (copy to .env.production.test — gitignored).
# Used by: ./run_production_tests (slim: /health + frontend HTTP + tests_remote).
# Also used as GitHub Actions secrets for test-production.yml:
#   PRODUCTION_TEST_USERNAME, PRODUCTION_TEST_PASSWORD
#   optional API_BASE_URL, FRONTEND_URL

# Live Railway backend (defaults from frontend/.env.production if omitted)
API_BASE_URL=https://web-production-dfcf8.up.railway.app

# Production Railway test user
TEST_USERNAME=sajadparacha@gmail.com
TEST_PASSWORD=your_production_password

# Or leave TEST_PASSWORD empty and export before running:
# export PRODUCTION_TEST_PASSWORD='...'

# Optional: live frontend URL for smoke checks / reporting
FRONTEND_URL=https://closiq.me

# Optional: set RUN_AI_TESTS=1 to include AI-calling remote tests (may incur cost)
# RUN_AI_TESTS=0
