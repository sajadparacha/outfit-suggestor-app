# Backend API URL
# For local development
REACT_APP_API_URL=http://localhost:8001

# For production (update with your Railway backend URL)
# REACT_APP_API_URL=https://your-app-name.railway.app

# Optional: use HTTPS in development (e.g. for PWA testing). Set in .env.development.local: HTTPS=true
# Or run: npm run start:https

# OAuth sign-in (required for live Google/Apple buttons)
# Web Google OAuth client ID (also list it in backend GOOGLE_CLIENT_IDS)
REACT_APP_GOOGLE_CLIENT_ID=
# Apple Services ID (web) — also list in backend APPLE_CLIENT_IDS
REACT_APP_APPLE_CLIENT_ID=
