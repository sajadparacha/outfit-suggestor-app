# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=8001

# Database Configuration
# For local development with PostgreSQL
DATABASE_URL=postgresql://your_username@localhost:5432/outfit_suggestor

# For production (Railway will auto-provide this)
# DATABASE_URL=postgresql://user:password@host:port/database

# Image Similarity Configuration
# Threshold for duplicate detection (0-10, default: 5)
# Lower = stricter matching, Higher = more lenient
IMAGE_SIMILARITY_THRESHOLD=5

# Max uploaded image size in MB (enforced by backend validate_image, default: 10)
MAX_IMAGE_SIZE_MB=10

# OAuth — comma-separated allowed audiences (client IDs) for ID token verification
# Include web + iOS Google client IDs. Include Apple Services ID and/or iOS bundle id.
# GOOGLE_CLIENT_IDS=123456789-web.apps.googleusercontent.com,123456789-ios.apps.googleusercontent.com
# APPLE_CLIENT_IDS=com.sajad.outfitsuggestor,com.sajad.outfitsuggestor.web

# Week plan named templates (presets) — max saved configs per user (default 10)
# WEEK_PLAN_PRESET_LIMIT_DEFAULT=10

# Premium wardrobe insights: OpenAI completion token budget (default: 8000)
# WARDROBE_GAP_MAX_TOKENS=8000

# CORS (comma-separated origins; no trailing slash)
# Example:
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://closiq.me,https://www.closiq.me
